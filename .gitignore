# 忽略 node_modules
node_modules/

# 忽略日志
*.log
npm-debug.log*

# 忽略环境变量
.env
.env.local
.env.*.local

# 忽略编辑器配置
.vscode/
.idea/
*.swp
*.swo
*~

# 忽略操作系统文件
.DS_Store
Thumbs.db

# 前端构建产物
frontend/dist/
frontend/.vite/

# 后端临时文件
backend/data/*.tmp

# 组合历史：每次生成就变一次的中间数据，且内嵌完整组合数组会无限膨胀
# 分类数据（categories.json）需要保留并随 git 提交
backend/data/combinations.json
